# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/standalone

# misc
.DS_Store
*.pem
*.log

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files - NEVER commit these
.env
.env.local
.env.development
.env.production
.env*.local

# Keep example files
!.env.example
!.env.production.example

# vercel
.vercel

# firebase
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log
*.cache

# typescript
*.tsbuildinfo
next-env.d.ts

# secrets & credentials - NEVER commit
*.p8
*.p12
*.key
*.pem
*-credentials.json
*-service-account.json
serviceAccountKey.json

# IDE
.idea/
.vscode/
*.swp
*.swo

# Icon bake-off evidence (archived outside git)
experiment-results/icon-rebuild/*
!experiment-results/icon-rebuild/README.md
