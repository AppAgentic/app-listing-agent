# =====================================================================
# App Listing Agent - environment variables
# =====================================================================
# Copy to .env.local (next dev) or pass to your container. Every variable
# the app reads is listed here. Values are placeholders: never commit real
# keys. NEXT_PUBLIC_* values are inlined into the browser bundle at BUILD
# time, so set them before `next build` / `docker build`.

# ---------------------------------------------------------------------
# 1. Required (every deployment)
# ---------------------------------------------------------------------

# Public URL of this deployment (no trailing slash). Used for OAuth/MCP
# metadata, billing links, legal page URLs and the MCP URL shown in the UI.
# Needed at build time (client pages) AND at runtime.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Firebase web app config (Firebase console > Project settings > Your apps).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin SDK (server only). Leave all three empty on Google Cloud to
# use Application Default Credentials. FIREBASE_ADMIN_PRIVATE_KEY may contain
# escaped \n newlines or be base64 encoded.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
# `next dev` only: use in-memory Firebase mocks. Ignored in production.
FIREBASE_ADMIN_USE_MOCKS=false

# Store credentials (App Store Connect / Google Play keys) are encrypted at
# rest. Pick ONE backend:
#  a) Local key (self-host default): 32 random bytes as base64 or 64 hex chars.
#     Generate with: openssl rand -base64 32
#     Keep it safe and stable: losing or changing it makes saved store
#     credentials unreadable. Used only when no GCP_KMS_* / GCP_PROJECT_ID is set.
CREDENTIALS_ENCRYPTION_KEY=
#  b) Google Cloud KMS envelope encryption (our hosted cloud). Setting any of
#     GCP_PROJECT_ID / GCP_KMS_KEYRING / GCP_KMS_KEY selects KMS.
GCP_PROJECT_ID=
GCP_KMS_LOCATION=global
GCP_KMS_KEYRING=
GCP_KMS_KEY=

# Google Gemini (translations, copy review, screenshot/icon planning).
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional fallback key used for direct REST calls when the primary Gemini
# call fails (e.g. a different project/quota).
GEMINI_DIRECT_API_KEY=

# Cloudflare R2 (S3-compatible) storage for screenshots, icons and uploads.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Public base URL of the bucket (custom domain or r2.dev URL). Its origin is
# added to the Content-Security-Policy (img/media/connect), so set it at build
# time too.
R2_PUBLIC_URL=

# ---------------------------------------------------------------------
# 2. Self-host mode
# ---------------------------------------------------------------------

# true = billing off: no paywall, no plan/trial step, unlimited allowances,
# billing/checkout/webhook routes return 404. Refused (stays off) whenever
# STRIPE_LIVEMODE=true or STRIPE_ACCOUNT_ID is the App Listing Agent live
# Stripe account, so it can never unlock a paid production deployment.
SELF_HOSTED=true
# Build-time twin for the browser bundle: turns off our hosted Microsoft
# Clarity project by default. Set it before `next build` on self-host.
NEXT_PUBLIC_SELF_HOSTED=true

# Who may sign up: `public` (anyone with a Firebase Auth account) or
# `invite_only` (invites, approved waitlist entries and the internal
# allowlist). When unset, NEXT_PUBLIC_WAITLIST_MODE decides (anything but
# `false` = waitlist).
SIGNUP_ACCESS_MODE=public
NEXT_PUBLIC_WAITLIST_MODE=false

# Comma-separated allowlist for internal integrations (RevenueCat, Gleap
# support, Crashlytics tools and internal pages). Empty = nobody. Match is
# case-insensitive; any one list matching grants access.
INTERNAL_INTEGRATION_ALLOWED_USER_IDS=
INTERNAL_INTEGRATION_ALLOWED_ORG_IDS=
INTERNAL_INTEGRATION_ALLOWED_EMAILS=
INTERNAL_INTEGRATION_ALLOWED_DOMAINS=

# ---------------------------------------------------------------------
# 3. Optional services (features degrade cleanly when unset)
# ---------------------------------------------------------------------

# Image generation. Icons default to OpenAI; ICON_ENGINE=fal switches to fal.
OPENAI_API_KEY=
ICON_ENGINE=
FAL_KEY=
KIE_API_KEY=

# AppSpy keyword/market data (https://appstorespy.com).
APPSPY_API_KEY=

# WorkOS AuthKit: OAuth for ChatGPT/Claude connectors. Without it, MCP still
# works with scoped API keys and the in-app agent pairing flow.
WORKOS_AUTHKIT_DOMAIN=
WORKOS_API_KEY=
# MCP resource identifier (defaults to <NEXT_PUBLIC_APP_URL>/api/mcp).
WORKOS_MCP_RESOURCE=
# Extra browser origins allowed to call /api/mcp (comma-separated).
MCP_ALLOWED_ORIGINS=
# Plain-text token served at /.well-known/openai-apps-challenge (OpenAI app
# domain verification). Leave empty unless you publish your own ChatGPT app.
OPENAI_APPS_CHALLENGE=

# Bearer secret (16+ chars) for scheduled jobs (analytics maintenance,
# billing reconcile). Unset = those endpoints refuse every call.
CRON_SECRET=
# Admin MCP endpoint (/api/admin-mcp). Unset = admin MCP disabled.
# Format: asc_admin_<64 hex chars>.
ASC_ADMIN_KEY=

# In-app support widget (Gleap SDK token, public).
NEXT_PUBLIC_GLEAP_SDK_TOKEN=
# Microsoft Clarity project id (session recordings). Empty or `off` = off.
# Unset = our hosted project, unless NEXT_PUBLIC_SELF_HOSTED=true.
NEXT_PUBLIC_CLARITY_ID=

# Guided setup-call booking link and its webhook secret.
CONCIERGE_BOOKING_URL=
CONCIERGE_BOOKING_WEBHOOK_SECRET=

# First-party product analytics into BigQuery. Anything but `true` = off.
APPSTORECOPILOT_PRODUCT_ANALYTICS_ENABLED=false
APPSTORECOPILOT_ANALYTICS_DATASET=
APPSTORECOPILOT_ANALYTICS_TABLE=events
# Extra origin accepted by /api/public/events (e.g. a preview host).
APPSTORECOPILOT_ANALYTICS_EXTRA_ORIGIN=

# Free listing audit (/audit) caps per server instance.
LISTING_AUDIT_AI_DAILY_CAP=300
LISTING_AUDIT_FRESH_PER_MINUTE=30
LISTING_AUDIT_FRESH_PER_DAY=400

# Logging (debug | info | warn | error).
LOG_LEVEL=info
# `next dev` only: extra dev origins (comma-separated hosts).
NEXT_ALLOWED_DEV_ORIGINS=

# Set automatically by the platform; listed for completeness.
# GCLOUD_PROJECT=          (Google Cloud project id, read by analytics/KMS fallbacks)
# GOOGLE_CLOUD_PROJECT=
# K_REVISION=              (Cloud Run revision, shown by /api/health)

# ---------------------------------------------------------------------
# 4. Cloud-only billing (Stripe Managed Payments) - leave empty when
#    SELF_HOSTED=true. See lib/stripe/config.ts: incomplete config fails
#    closed (checkout and webhook return 503, no paid access).
# ---------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_SECRET_PREVIOUS=
STRIPE_ACCOUNT_ID=acct_xxx
STRIPE_LIVEMODE=false
STRIPE_PORTAL_CONFIGURATION_ID=bpc_xxx
STRIPE_PRICE_STARTER_MONTHLY=price_xxx
STRIPE_PRICE_STARTER_ANNUAL=price_xxx
STRIPE_PRICE_PRO_MONTHLY=price_xxx
STRIPE_PRICE_PRO_ANNUAL=price_xxx
STRIPE_PRICE_BUSINESS_MONTHLY=price_xxx
STRIPE_PRICE_BUSINESS_ANNUAL=price_xxx
BILLING_TRIAL_DAYS=7
BILLING_CHECKOUT_ENABLED=false
NEXT_PUBLIC_BILLING_CHECKOUT_ENABLED=false
